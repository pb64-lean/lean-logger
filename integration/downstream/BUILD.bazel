"""Dependency-mode smoke test for the application-facing API."""

load("@rules_lean//lean:defs.bzl", "lean_test")

package(default_visibility = ["//visibility:private"])

lean_test(
    name = "public_api_test",
    size = "small",
    srcs = ["PublicApiTest.lean"],
    deps = ["@lean-logger//:lean_logger"],
)

lean_test(
    name = "layer_api_test",
    size = "small",
    srcs = ["LayerApiTest.lean"],
    deps = [
        "@lean-logger//lean/Loggers:core",
        "@lean-logger//lean/Loggers:format",
        "@lean-logger//lean/Loggers:runtime",
        "@lean-logger//lean/Loggers:testkit",
    ],
)
