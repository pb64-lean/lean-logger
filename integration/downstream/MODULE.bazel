"""Standalone dependency-mode consumer fixture."""

module(
    name = "lean-logger-downstream-test",
    version = "0.0.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "lean-logger", version = "0.1.0")
local_path_override(
    module_name = "lean-logger",
    path = "../..",
)

bazel_dep(name = "rules_lean", version = "0.1.0")
archive_override(
    module_name = "rules_lean",
    integrity = "sha256-R04+5hNuca2KRdLDQDnQ68hZYjpKcw6p6kz/aU/fmAc=",
    strip_prefix = "rules_lean-fbc2dd0626da1dee86348ff4841798ea8c8cbb34",
    urls = [
        "https://github.com/pb64-lean/rules_lean/archive/fbc2dd0626da1dee86348ff4841798ea8c8cbb34.tar.gz",
    ],
)

lean = use_extension(
    "@rules_lean//lean:extensions.bzl",
    "lean",
    dev_dependency = True,
)
lean.nix_toolchain(
    name = "lean4",
    attr = "lean4_upstream_std",
    # Exercise dependency-mode registration with the library's supported Lean
    # revision; the rules archive may still carry an older compiler pin.
    nix_file = "@lean-logger//third_party/lean:nixpkgs.nix",
    nix_file_deps = ["@lean-logger//third_party/lean:nixpkgs.json"],
)
use_repo(lean, "lean4_toolchain")

register_toolchains(
    "@lean4_toolchain//:all",
    dev_dependency = True,
)
