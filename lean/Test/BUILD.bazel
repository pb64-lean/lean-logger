"""Focused tests for each logging layer."""

load("@rules_lean//lean:defs.bzl", "lean_test")

package(default_visibility = ["//visibility:public"])

lean_test(
    name = "core_test",
    size = "small",
    srcs = ["CoreTest.lean"],
    strip_module_prefix = "lean",
    deps = ["//lean/Loggers:core"],
)

lean_test(
    name = "format_test",
    size = "small",
    srcs = ["FormatTest.lean"],
    strip_module_prefix = "lean",
    deps = ["//lean/Loggers:format"],
)

lean_test(
    name = "runtime_test",
    size = "small",
    srcs = ["RuntimeTest.lean"],
    strip_module_prefix = "lean",
    deps = ["//lean/Loggers:runtime"],
)

lean_test(
    name = "async_appender_test",
    size = "small",
    srcs = ["AsyncAppenderTest.lean"],
    strip_module_prefix = "lean",
    deps = [
        "//lean/Loggers:runtime",
        "//lean/Loggers:testkit",
    ],
)

lean_test(
    name = "duplicate_suppression_test",
    size = "small",
    srcs = ["DuplicateSuppressionTest.lean"],
    strip_module_prefix = "lean",
    deps = [
        "//lean/Loggers:runtime",
        "//lean/Loggers:testkit",
    ],
)

lean_test(
    name = "testkit_test",
    size = "small",
    srcs = ["TestkitTest.lean"],
    strip_module_prefix = "lean",
    deps = ["//lean/Loggers:testkit"],
)
